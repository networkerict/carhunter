<!DOCTYPE html>
<html>

<head>

<title>AutoHunter Ranking</title>

<link rel="stylesheet" href="/static/style.css">

</head>


<body>


<div class="header">

<h1>🏆 AutoHunter Ranking Top 10</h1>

<a href="/rescore" class="ranking-button">
🔄 Scores opnieuw berekenen
</a>

</div>

<p>
<a href="/">← Terug naar zoeken</a>
</p>

</div>



<div class="layout">


<div class="cars">


{% for car in cars %}


<div class="card">


<h2>
#{{ loop.index }} {{ car.title }}
</h2>


<h3>
Score: {{ car.final_score }}
</h3>


<p>
💰 €{{ car.price }}
<br>
📅 {{ car.year }}
<br>
🚗 {{ car.km }} km
</p>


<hr>


<p>
<b>Score breakdown</b>
<br>

Car: {{ car.car_score }}
<br>

Value: {{ car.value_score }}
<br>

Options: {{ car.options_score }}
<br>

Premium: {{ car.premium_score }}

</p>


{% if car.options_found %}

<hr>

<h3>Opties</h3>

<ul>

{% for option in car.options_found.split(",") %}

<li>
✓ {{ option.strip() }}
</li>

{% endfor %}

</ul>

{% endif %}


<a href="/car/{{ car.id }}">
Bekijk details
</a>


</div>


{% endfor %}


</div>


</div>


</body>

</html>
