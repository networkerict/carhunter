<!DOCTYPE html>
<html>

<head>

<title>AutoHunter Deals</title>

<link rel="stylesheet" href="/static/style.css">

</head>


<body>

<div class="header">

<h1>🔥 AutoHunter Deals</h1>

<a href="/" class="ranking-button">
🏠 Home
</a>

</div>


<div class="cards">


{% for car in cars %}


<div class="car-card">


<h2>
{{car.title}}
</h2>


<div class="deal-score">

🔥 Deal score:
<strong>{{car.deal_score}}</strong>

</div>


<p>
💰 Prijs:
<strong>
€{{"{:,}".format(car.price).replace(",",".")}}
</strong>
</p>


{% if car.price_drop %}

<p class="drop">

🔻 Prijsdaling:
€{{car.price_drop}}

</p>

{% endif %}



<p>
⭐ Auto score:
{{car.final_score}}
</p>


<p>
🎯 Opties:
{{car.options_score}}
</p>


<p>
📅 {{car.year}}
 |
 🚗 {{car.km}} km
</p>


<p>
{{car.color}}
 |
 {{car.hp}} pk
 |
 {{car.drive}}
</p>


<a href="/car/{{car.id}}">
Bekijk auto →
</a>


</div>


{% endfor %}


</div>


</body>

</html>
